# Copie para .env e ajuste. Valores abaixo são fictícios / apenas para desenvolvimento.
APP_ENV=development
SECRET_KEY=troque-por-uma-chave-aleatoria
# Token exigido no header X-Admin-Token para DELETE /tasks|/users|/categories e para definir role != user
ADMIN_TOKEN=dev-admin-token
# Validade (segundos) do token assinado devolvido por POST /login e enviado em Authorization: Bearer <token>
TOKEN_MAX_AGE=3600
DATABASE_URL=sqlite:///tasks.db
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Senhas das contas criadas por seed.py — APENAS DESENVOLVIMENTO.
# Se uma variável não estiver definida, o seed gera uma senha aleatória e a imprime uma vez.
SEED_ADMIN_PASSWORD=1234
SEED_USER_PASSWORD=abcd
SEED_MANAGER_PASSWORD=pass
