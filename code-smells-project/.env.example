# Exporte estas variáveis no shell antes de subir a aplicação (o projeto NÃO lê arquivos .env:
# não há python-dotenv nas dependências). Todos os valores abaixo são fictícios / apenas de desenvolvimento.
#
#   export $(grep -v '^#' .env.example | xargs)   # atalho para carregar os defaults de dev

# development ou test aceitam os defaults inseguros abaixo.
# Qualquer outro valor (production, staging, ...) exige SECRET_KEY e ADMIN_TOKEN próprios no boot.
APP_ENV=development

# Assina os tokens emitidos por POST /login. O valor abaixo é o default de desenvolvimento,
# é público e deve ser considerado comprometido: fora de development/test o boot recusa este valor.
SECRET_KEY=dev-only-insecure-key
# Validade do token de login, em segundos.
TOKEN_MAX_AGE=3600

FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db

# Exigido no header X-Admin-Token das rotas administrativas (/admin/*, escrita de produtos,
# status de pedidos, listagens completas e relatório). O valor abaixo é o default de
# desenvolvimento, é público: fora de development/test o boot recusa este valor.
ADMIN_TOKEN=dev-admin-token

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Senhas das contas criadas pelo seed no primeiro boot (apenas desenvolvimento).
# Sem estas variáveis, o seed gera uma senha aleatória por conta e a registra uma única vez no log.
# Os valores abaixo reproduzem os logins usados no baseline.
SEED_ADMIN_PASSWORD=admin123
SEED_JOAO_PASSWORD=123456
SEED_MARIA_PASSWORD=senha123
