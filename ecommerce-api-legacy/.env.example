# Copie para .env (ignorado pelo git) e ajuste. Valores abaixo são fictícios.
# Uso: export $(grep -v '^#' .env | xargs) && npm start   (ou: node --env-file=.env src/app.js)

# development | production (em production ADMIN_TOKEN e PAYMENT_GATEWAY_KEY são obrigatórios)
APP_ENV=development
PORT=3000
HOST=127.0.0.1
# ':memory:' recria schema + seed a cada boot; use um caminho de arquivo para persistir
DB_PATH=:memory:

# Enviado no header X-Admin-Token para GET /api/admin/financial-report e DELETE /api/users/:id.
# Não há default no código: se esta variável ficar vazia fora de produção, o app gera um token
# aleatório por boot e o registra no log ("ADMIN_TOKEN não definido; token gerado..."). Em
# production, o boot falha sem ela. Troque o valor abaixo pelo seu — ele é só um placeholder.
ADMIN_TOKEN=troque-este-valor-apenas-desenvolvimento

# Chave do gateway de pagamento (apenas injetada; o gateway deste projeto é simulado).
PAYMENT_GATEWAY_KEY=pk_test_replace_me

# Senha em texto do usuário inicial (leonan@fullcycle.com.br), gravada com hash scrypt.
# Vazia fora de produção = senha aleatória gerada e registrada no log a cada seed.
# Apenas desenvolvimento. Em production o seed recusa rodar sem esta variável.
SEED_USER_PASSWORD=troque-esta-senha-apenas-desenvolvimento

LOG_LEVEL=info
